# Supabase — Frontend (ANON KEY ONLY, never the service role key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL for the API backend. Empty = same origin (Vercel serverless /api/*).
# Local dev (run `pnpm --filter server dev` on :3001): http://localhost:3001
VITE_API_URL=
